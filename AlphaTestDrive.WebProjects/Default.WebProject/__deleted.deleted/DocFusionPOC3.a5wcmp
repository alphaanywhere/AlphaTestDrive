        "XbasicFunctionDeclarations": "function Call_DocFusionPDFGenerate as c (e as p)\n\t\n\t'debug(1)\n\tdim json_string as c \n\tjson_string = <<%str%\n\t\t{\n\t\t\t\"Firstname\":\"__fname__\",\n\t\t\t\"Lastname\":\"__lname__\",\n\t\t\t\"OrderID\":\"ORDER#: __order_id__\",\n\t\t\t\"Order_Items\":[\n\t\t\t\t__order_items__\n\t\t\t\t]\n\t\t}\n\t%str%\n\n\t\n\tdim conn as SQL::Connection\n\tdim rs as SQL::ResultSet\n\tdim sql as C\n\tdim args as SQL::Arguments\n\targs.add(\"customer_id\", e.DATASUBMITTED.CUSTOMERS)\n\targs.add(\"order_id\", e.DATASUBMITTED.ORDERS)\n\tsql = <<%str%\n\t\tSELECT \n\t\t\tDISTINCT\n\t\t\tfirst_name,\n\t\t\tlast_name,\n\t\t\tOrders.order_id AS order_id\n\t\tFROM Order_Items\n\t\tLEFT OUTER JOIN Orders ON Orders.order_id = Order_Items.order_id\n\t\tLEFT OUTER JOIN Customers ON Customers.customer_id = Orders.customer_id\n\t\tWHERE Orders.order_id = :order_id AND Customers.customer_id = :customer_id;\n\t%str%\n\t\n\tconn.open(\"::Name::Conn\")\n\tconn.execute(sql, args)\n\trs = conn.ResultSet\n\tjson_string = stritran(json_string,\"__fname__\",rs.data(\"first_name\"))\n\tjson_string = stritran(json_string,\"__lname__\",rs.data(\"last_name\"))\n\tjson_string = stritran(json_string,\"__order_id__\",convert_typE(rs.data(\"order_id\"),\"c\"))\n\n\tdelete rs\n\tsql = <<%str%\n\t\tSELECT \n\t\t\t\tproduct_name AS ItemName,\n\t\t\t\tquantity AS ItemQty,\n\t\t\t\tunit_price AS ItemRate,\n\t\t\t\t(quantity * unit_price) AS ItemPrice\n\t\tFROM Order_Items\n\t\tLEFT OUTER JOIN Orders ON Orders.order_id = Order_Items.order_id\n\t\tLEFT OUTER JOIN Customers ON Customers.customer_id = Orders.customer_id\n\t\tWHERE Orders.order_id = :order_id AND Customers.customer_id = :customer_id;\n\t%str%\n\tconn.execute(sql, args)\n\trs = conn.ResultSet\n\ttxt = rsToJSON(rs)\n\ttxt = crlf_to_comma(txt)\n\tjson_string = stritran(json_string,\"__order_items__\",txt)\n\n\tconn.close()\n\n\t\n\t\n\tdim response as p\n\tresponse = DocFusion_GenerateDocument(e,json_string,e.DATASUBMITTED.CLIENT_ID,e.DATASUBMITTED.CLIENT_SECRET,e.DATASUBMITTED.BusinessUnitGuid,e.DATASUBMITTED.TemplateGuid,e.DATASUBMITTED.ChainGuid,\"\")\n\t\n\tdim jsStr as c\n\tif eval_valid(\"response.errors\") then\n\t\tdim errorMsg as c\n\t\terrorMsg = json_generate(response.errors._)\n\t\tjsStr = system_msgbox(\"DocFusion Error\",js_Escape(\"Contact Admin!\"),\"E\")\n\telse\n\t\tif eval_valid(\"response.DocumentData\") then\n\t\t \tfilename = Base64ToPDFFile(response.DocumentData)\n\t\t\tdim clientsideFilename as c = \"MyReport.pdf\"\n\t\t\tif e.DATASUBMITTED.PDFFILENAME <> \"\" then\n\t\t\t\tclientsideFilename =  e.DATASUBMITTED.PDFFILENAME + \".pdf\"\n\t\t\tend if\n\t\t\tdim componentAlias as c\n\t\t\tcomponentAlias = e.tmpl.alias\n\t\t\tjsStr = a5Helper_generateFileDownloadJS(componentAlias, filename, clientsideFilename)\n\n\t\tend if\n\tend if\n\t\n\tCall_DocFusionPDFGenerate = jsStr + \"{dialog.object}.hideWaitMessage();\"\n\t\nend function \n",
        "onTimerEventInterval": 60,

                "scriptMetaData": "<a_ajs<[1]<action=\"Display a 'Wait...' message.\">\n<icon=\"$$generic.hourGlass\">\n<isCommentedOut=.F.>\n<comment=\"\">\n<builder=\"a5ajs_waitMessage(v,wf,pv,dlg_mode)\">\n<metaData=<<%str%\n<lockWhat=\"Page\">\n<elementId=\"\">\n<containerId=\"\">\n<panelId=\"\">\n<useCSSAnimation=.F.>\n<message<text=\"Wait...\">\n<waitIcon=\"css/A5System/Images/wait.gif\">\n>\n<cssAnimation<size=\"32\">\n>\n<waitMessageAutoCloseDelay=\"10000\">\n%str%>\n<javascriptAttribute=\"{dialog.object}.showWaitMessage('page',{useCSSAnimation: false,message: 'Wait...',icon: 'css/A5System/Images/wait.gif',waitMessageAutoCloseDelay: 10000});\">\n<Javascriptdeclarations_row=\"\">\n<Javascriptdeclarations_global=\"\">\n<xbasicFunctions=\"\">\n<display=\"{I:'$$generic.hourGlass'}{F=Tahoma,10}{C=Dark Blue,White}{B=Blue White,Dark Blue}Display a 'Wait...' message.{T=4}{I:'a5_vertical_line'}\">\n<keep=.T.>\n>\n<[2]<display=\"{I:'$$edit.redo'}{F=Tahoma,10}{C=Dark Blue,White}{B=Blue White,Dark Blue}Ajax Callback  {T=4}{I:'a5_vertical_line'}\">\n<action=\"Ajax Callback  \">\n<icon=\"$$edit.redo\">\n<isCommentedOut=.F.>\n<comment=\"\">\n<builder=\"a5ajs_AjaxCallBack(v, dlg_mode, wf)\">\n<metaData=<<%str%\n<flagSubmitData=.T.>\n<part=\"Grid\">\n<GridRowNumber=\"{Grid.RowNumber}\">\n<ajaxCallbackType=\"InternalXbasicFunction\">\n<functionName=\"Call_DocFusionPDFGenerate\">\n<callbackURL=\"\">\n<callbackActionName=\"\">\n<otherData=\"\">\n<computeCurrentRowdata=.F.>\n<submitLocationInfo=.F.>\n<ajaxFailedJavascript=\"\">\n<offlineJavascript=\"alert('Internet connection not available');\">\n<afterCallbackCompleteJavascript=\"\">\n<locationHighAccuracy=.T.>\n<locationTimeout=15000>\n<locationMaxAge=30000>\n<ajaxcallbacktimeout=\"<Default>\">\n<ajaxRetryCount=\"\">\n<chunkedResponses<allow=.F.>\n<maxMessages=-1>\n<maxTime=600>\n>\n<submitListData=.T.>\n<checkifserveravailable=.T.>\n<serveravailabletimeout=2000>\n<servernotavailablejavascript=\"alert('The server is not available');\">\n<peformspeedtest=.F.>\n<amountofdatatosend=\".1MB\">\n<maxspeedtestduration=300>\n<poorconnectionJavascript=\"\">\n<submitcheckedrows=.F.>\n<submitcheckrowsForList=\"\">\n%str%>\n<javascriptAttribute=<<%str%\n\n{dialog.object}.ajaxCallback('','','Call_DocFusionPDFGenerate','','',{chunkedResponses: {allow: false},deviceOfflineFunction: function() { alert('Internet connection not available');  },submitListData: true,checkifserveravailable: true,serveravailabletimeout: 2000,onServerNotAvailable: function() { alert('The server is not available');}});%str%>\n<Javascriptdeclarations_row=\"\">\n<Javascriptdeclarations_global=\"\">\n<xbasicFunctions=\"\">\n<keep=.T.>\n>\n>\n<flagRunSynchronously=.F.>\n<flagWrapInTryCatch=.F.>\n<tryCatchJavascript=\"\">\n"
            },

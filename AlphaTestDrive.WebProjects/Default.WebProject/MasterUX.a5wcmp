				"ControlHTML": "\t<div class=\"\">\r\n\t\t<div id=\"{alias}_DIVCONTAINER_c3e70ba0_4e72_4e5d_a061_5f645cb00174\"   ><img src=\"css/A5System/Images/wait.gif\" /> Working...</div>\r\n\t</div><!--breakbegin--><br  style=\"clear:both; \" /><!--breakend-->\r\n\t\t",

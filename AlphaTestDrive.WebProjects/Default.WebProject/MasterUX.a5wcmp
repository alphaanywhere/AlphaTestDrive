					"flow": "LTR",
					"animation": {
						"type": "slide",
						"duration": 200
					},
					"javascript": {
						"onSwipe": "\r\nif(e.swipeDirection == 'left') { \r\n\t\r\n\t//close the menu panel if you are on a device where the menu is only shown on demand\r\n\t//first, get a poiner to the top level PanelLayout\r\n\tvar pObj = {dialog.object}.panelGet('PANELLAYOUT_1');\r\n\t//then call this object's .hideDock() method to hide the menu.\r\n\tpObj.hideDock();\r\n\t\r\n} else if(e.swipeDirection == 'right') { \r\n\t//show the menu\r\n\t{dialog.object}.panelSetActive('MENUPANEL');\r\n}\r\n\t\r\n\t\r\n\t\r\n\t\r\n\t\r\n\r\n\r\n",
						"onBeforeDockPanelHide": "",
						"onPanelView": "",
						"onResize": "",
						"_onsize": "if(typeof {dialog.object} != 'undefined') {\r\n\tif(typeof {dialog.object}._findActiveLayoutRule != 'undefined') { \r\n\t\t{dialog.object}._findActiveLayoutRule();\r\n\t\t//alert('system on size');\r\n\t}\r\n}\r\n"
					},
					"dock": {
						"method": "Over",
						"flowLock": {
							"has": true,
							"autohide": true
						},
						"dockButtons": "MENUBUTTON>MENUPANEL"
					},
					"resizeClassname": "",
					"behavior": "Fixed",
					"hasScroller": true,
					"scrollerJSON": ""
				},

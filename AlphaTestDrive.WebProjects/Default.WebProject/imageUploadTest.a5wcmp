div style=\\\"width:1in;cursor:default;\\\">OK</div>\">\n<additionalInfoToSubmitJavascript=\"\">\n%str%>\n<javascriptAttribute=\"{dialog.object}._functions.BUTTON_1_ACTIONBUTTON_{ACTIONNUMBER}(this);\">\n<Javascriptdeclarations_row=\"\">\n<Javascriptdeclarations_global=<<%str%\n{dialog.object}._functions.BUTTON_1_ACTIONBUTTON_{ACTIONNUMBER} = function(objEle) {\n\n\nif({grid.object}._embeddedMode) {\n\talert('File upload is not supported when the Component is running on the Desktop.');\n\treturn false;\n}\n\n\nvar rowNum = 1;\nvar instanceNumber = {dialog.object}.getInstanceNumber('image1');\n\n\nwindow['{Dialog.ComponentName}_ACTIONBUTTON_idgaa'] = {Dialog.object}.createWindow('{Dialog.componentName}_WINDOW_ACTIONBUTTON_idgaa','modal-url',\n{\theight: '3in',\n\twidth: '5in',\n\ttitle: {html: 'Select File<span id=\"5c624316fff74cb288c542ae9029cddf\"></span>' },\n\ttheme: '{Dialog.style}',\n\tbody: {content: {type: 'url',\n\turl: 'about:blank'}},\n\tbuttons: {\n\t\titems: [\n\t\t\t{html: '<div style=\"width:1in;cursor:default;\">Upload</div>', width: '', name: 'UPLOAD', action: function() {$(this.getWindowId('body')).contentWindow.A5.fileUpload.upload(); }},\n\n\t\t\t{html: '<div style=\"width:1in;cursor:default;\">OK</div>', width: '', name: 'OK', action: function() {$(this.getWindowId('body')).contentWindow.okToSave(); }},\n\t\t\t{html: 'Cancel',width: '', name: 'Cancel', action: function() { this.hide(); } }\n\t\t]\n\t},\n\tonHide: function() { var ele = $('{dialog.componentname}.V.R'+1+'.IMAGE1');\nvar oldImg = $ga(ele,'oldImage');\nif(oldImg) $svs(ele,oldImg);\n  ; this.refresh(); }\n}\n);\n\nwindow['{Dialog.ComponentName}_ACTIONBUTTON_idgaa'].clearTools();\nwindow['{Dialog.ComponentName}_ACTIONBUTTON_idgaa'].setButtonDisplay('OK',false);\nwindow['{Grid.ComponentName}_ACTIONBUTTON_idgaa'].setButtonDisplay('UPLOAD',true);\n\nwindow['{Dialog.ComponentName}_ACTIONBUTTON_idgaa'].getButton('Cancel').refresh();\nwindow['{Dialog.ComponentName}_ACTIONBUTTON_idgaa'].show
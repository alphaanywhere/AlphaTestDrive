                "scriptMetaData": "<a_ajs<[1]<display=\"{I:'$$file.import'}{F=Tahoma,10}{C=Dark Blue,White}{B=Blue White,Dark Blue}Image Upload{T=4}{I:'a5_vertical_line'}UploadPic\">\n<action=\"Image Upload\">\n<icon=\"$$file.import\">\n<isCommentedOut=.F.>\n<comment=\"UploadPic\">\n<builder=\"a5ajs_imageFieldUpload(v,wf,pv,dlg_mode)\">\n<metaData=<<%str%\n<gridImageField=\"image1 (C)\">\n<ajaxWindowPositionAttribute=\"\">\n<ajaxWindowPositionAttributeEnglish=\"\">\n<applicationType=\"Desktop\">\n<uploadProperties<target=\"Server\">\n<cloudStorage<specifyCredentials=\"Named Storage Connection String\">\n<connectionString=\"\">\n<credentials<access_key=\"\">\n<secret=\"\">\n>\n<bucketName=\"\">\n<region=\"\">\n<allowMultipleFiles=.F.>\n<maxFileSize=-1>\n<maxFileSizeTotal=-1>\n<allowedFileTypes=\"\">\n<authenticatedRead=.F.>\n<displayProgress=.F.>\n<allowCancel=.T.>\n<progressStyle=\"Bar\">\n<progressBarColor=\"#9fa1e8\">\n<progressBarWidth=\"1.5in\">\n<progressDisplayPlaceholder=\"\">\n<javascript<onAfterFilesSelect=\"\">\n<onCompleteIndividualFile=\"\">\n<onCompleteAllFiles=\"\">\n<onBeforeFileSelect=\"\">\n<onValidationError=\"\">\n<onError=\"\">\n<onProgress=\"\">\n<targetName=\"\">\n>\n<customization<maxFileSize=\"Selected file [filename] (size [filesize]) exceeds the maximum allowed file size of [maxfilesize].\">\n<totalFileSize=\"Selected files ([filecount] files, total size [totalfilesize]) exceed the maximum allowed total file size of [maxtotalfilesize].\">\n<fileType=\"Selected file ([filename]) is not an allowed file type.\">\n>\n<targetFolder=\"\">\n>\n<storeThumbnails=.F.>\n<thumbNailDefinition=\"\">\n<uploadFolder=\"profilePics\">\n<fileExistAction=\"Rename\">\n<storedValueExpression=\"\\\"profilePics/<ShortFilename>\\\"\">\n<maxFileSize=\"1000000\">\n<maxFileSizeExceededMessage=\"You have selected a file that exceeds the maximum allowed file size of {filesize} bytes.\">\n<allowedImageExtensions=\".bmp,.jpg,.jpeg,.png\">\n<invalidExtensionErrorText=\"The
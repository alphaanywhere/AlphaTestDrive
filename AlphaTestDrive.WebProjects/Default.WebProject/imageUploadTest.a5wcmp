                "code": "<[1]<sectionName=\"<Top Level>\">\n<_aliasesAtThisLevel=<<%str%\nAASystemTable_Extend\n%str%>\n<maxRowsToDisplay=1>\n<cascadingDropdownsInSection=\"\">\n<alias<[1]<aliasName=\"AASystemTable_Extend\">\n<tableInfoForAlias=<<%str%\nUserId=C|F|T|NationalCharacter|!!|UserId\nFirstname=C|F|T|NationalCharacter|!!|Firstname\nLastname=C|F|T|NationalCharacter|!!|Lastname\nAvatarURL=C|F|T|NationalCharacter|!!|AvatarURL\nCompany=C|F|T|NationalCharacter|!!|Company\nDepartment=C|F|T|NationalCharacter|!!|Department\nSecurityGroups=C|F|T|NationalCharacter|!!|SecurityGroups\nEmail=C|F|T|NationalCharacter|!!|Email\nOtherOptionsJSON=C|F|T|NationalVaryingCharacter|!!|OtherOptionsJSON\nMiscJSON=C|F|T|NationalVaryingCharacter|!!|MiscJSON\nTenantId=C|F|T|NationalCharacter|!!|TenantId\n%str%>\n<tableName=\"AASystemTable_ExtendedUserInfo\">\n<variablesAndCorrespondingFieldNameForAlias=<<%str%\nname|Firstname|T|F||C\nimage1|AvatarURL|T|F||C\n%str%>\n<variablesAndCorrespondingEncryptionInfo=<<%str%\nname=F|\nimage1=F|\n%str%>\n<variableAndCorrespondingFieldArrayIndex=<<%str%\nname|2\nimage1|3\n%str%>\n<indexIntoTableArray=1>\n<parentLinkFields=\"\">\n<parentLinkVariables=\"\">\n<linkFields=\"\">\n<linkFieldsForDownstreamLinks=\"\">\n<tableType=\"SQL\">\n<parent=\"\">\n<readOnly=.F.>\n<sqlInsertSequence=\"\">\n<SQL_SecondPass=\"\">\n<allLinkedFields_onetomany=\"\">\n<allLinkedFields_onetoone=\"\">\n<xbToSetLinkingArguments_oneToMany=\"\">\n<xbToSetLinkingArguments_oneToOne=\"\">\n<xbToSetLinkingArguments_oneToManyFullyQualifiedFieldNames=\"\">\n<primaryKeyFields=\"UserId\">\n<primaryKeyIsAutoIncrement=.F.>\n<sequenceName=\"\">\n<_isLevelParent=.T.>\n<tableInfo=<<%str%\nUserId=C|F|T|NationalCharacter|!!|UserId\nFirstname=C|F|T|NationalCharacter|!!|Firstname\nLastname=C|F|T|NationalCharacter|!!|Lastname\nAvatarURL=C|F|T|NationalCharacter|!!|AvatarURL\nCompany=C|F|T|NationalCharacter|!!|Company\nDepartment=C|F|T|NationalCharacter|!!|Department\nSecurityGroups=C|F|T|NationalCharacter|!!|SecurityGroups\nEmail=C|F|T|NationalCharacter|!!|Email\nOtherOptionsJSON=C|F|T|NationalVaryingCharacter|!!|OtherOptionsJSON\nMiscJSON=C|F|T|NationalVaryingCharacter|!!|MiscJSON\nTenantId=C|F|T|NationalCharacter|!!|TenantId\n%str%>\n<UpdateWhereClause=<<%str%\n{UserId}=UserId = :old_UserId\n{Firstname}=(Firstname = :old_Firstname OR Firstname IS NULL AND :old_Firstname IS NULL)\n{Lastname}=(Lastname = :old_Lastname OR Lastname IS NULL AND :old_Lastname IS NULL)\n{AvatarURL}=(AvatarURL = :old_AvatarURL OR AvatarURL IS NULL AND :old_AvatarURL IS NULL)\n{Company}=(Company = :old_Company OR Company IS NULL AND :old_Company IS NULL)\n{Department}=(Department = :old_Department OR Department IS NULL AND :old_Department IS NULL)\n{SecurityGroups}=(SecurityGroups = :old_SecurityGroups OR SecurityGroups IS NULL AND :old_SecurityGroups IS NULL)\n{Email}=(Email = :old_Email OR Email IS NULL AND :old_Email IS NULL)\n{OtherOptionsJSON}=(OtherOptionsJSON = :old_OtherOptionsJSON OR OtherOptionsJSON IS NULL AND :old_OtherOptionsJSON IS NULL)\n{MiscJSON}=(MiscJSON = :old_MiscJSON OR MiscJSON IS NULL AND :old_MiscJSON IS NULL)\n{TenantId}=(TenantId = :old_TenantId OR TenantId IS NULL AND :old_TenantId IS NULL)\n%str%>\n<primaryKeyFieldTypes=\"C\">\n<primaryKeyValueSource=\"<VariableInSameAlias>\">\n<primaryKeyFieldsNative=<<%str%\nUserId\n%str%>\n<tableNameNative=\"AASystemTable_ExtendedUserInfo\">\n<sql<FieldArgInfo<[1]<varname=\"name\">\n<fieldname=\"Firstname\">\n<updateable=.T.>\n<encrypted=\"F\">\n<encryptionKey=\"\">\n<datatype=\"C\">\n<nativeFieldName=\"Firstname\">\n<fieldInfo=\"C|F|T|NationalCharacter|!!|Firstname\">\n<isObjectField=.F.>\n<indexIntoArray=2>\n<updateWhere=\"(Firstname = :old_Firstname OR Firstname IS NULL AND :old_Firstname IS NULL)\">\n<sqlInsertSequence=\"\">\n<primaryKey=.F.>\n<fieldType=\"C\">\n<isFileUpload=.F.>\n<isImage=.F.>\n<isSignatureCapture=.F.>\n<argumentName=\":AASystemTable_Extend_Firstname\">\n<argumentNameForInsert=\":AASystemTable_Extend_Firstname\">\n<argumentName_New=\":New_Firstname\">\n<argumentName_Old=\":Old_Firstname\">\n<setField=\"Firstname = :AASystemTable_Extend_Firstname\">\n<setArgument=\"convert_type(e.dataSubmitted.name,\\\"C\\\")\">\n<setArgument_New=\"convert_type(e.dataSubmitted.name,\\\"C\\\")\">\n<setArgument_Old=\"convert_type(e.oldDataSubmitted.name,\\\"C\\\")\">\n<autoIncrement=.F.>\n<xbset=\"sqlArgs.add(\\\"AASystemTable_Extend_Firstname\\\",convert_type(e.dataSubmitted.name,\\\"C\\\"))\">\n>\n<[2]<varname=\"image1\">\n<fieldname=\"AvatarURL\">\n<updateable=.T.>\n<encrypted=\"F\">\n<encryptionKey=\"\">\n<datatype=\"C\">\n<nativeFieldName=\"AvatarURL\">\n<fieldInfo=\"C|F|T|NationalCharacter|!!|AvatarURL\">\n<isObjectField=.F.>\n<indexIntoArray=3>\n<updateWhere=\"(AvatarURL = :old_AvatarURL OR AvatarURL IS NULL AND :old_AvatarURL IS NULL)\">\n<sqlInsertSequence=\"\">\n<primaryKey=.F.>\n<fieldType=\"C\">\n<isFileUpload=.F.>\n<isImage=.T.>\n<isSignatureCapture=.F.>\n<argumentName=\":AASystemTable_Extend_AvatarURL\">\n<argumentNameForInsert=\":AASystemTable_Extend_AvatarURL\">\n<argumentName_New=\":New_AvatarURL\">\n<argumentName_Old=\":Old_AvatarURL\">\n<setField=\"AvatarURL = :AASystemTable_Extend_AvatarURL\">\n<setArgument=\"convert_type(e.dataSubmitted.image1,\\\"C\\\")\">\n<setArgument_New=\"convert_type(e.dataSubmitted.image1,\\\"C\\\")\">\n<setArgument_Old=\"convert_type(e.oldDataSubmitted.image1,\\\"C\\\")\">\n<autoIncrement=.F.>\n<xbset=\"sqlArgs.add(\\\"AASystemTable_Extend_AvatarURL\\\",convert_type(e.dataSubmitted.image1,\\\"C\\\"))\">\n>\n>\n<flagPrimaryKeyIsAutoIncrement=.F.>\n<flagPrimaryKeyIsGUID=.F.>\n<primaryKey_setArgumentsXbasic=<<%str%\nargs.add(\"PRIMARYKEY_AASystemTable_Extend_1\",convert_type(e.dataSubmitted.,\"C\"))\n%str%>\n<primaryKey_setArgumentsXbasic_Method2=\"\">\n<primaryKey_setArgumentsXbasicMethodused=\"varinsamealias\">\n<refreshRowSQL=\"SELECT Firstname,AvatarURL,UserId FROM AASystemTable_ExtendedUserInfo WHERE UserId = :PRIMARYKEY_AAS
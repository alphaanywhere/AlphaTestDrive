[is].rows[ir].alias[ia].primaryKeyValue[1].value = rs.data(\"UserId\")\n\na_sections[is].rows[ir].alias[ia].primaryKeyArgsXML = args.xml\n%str%>\n>\n<updateablefields=<<%str%\nFirstname\nAvatarURL%str%>\n>\n>\n>\n>\n<sql<sqlSelect=\"SELECT FIRST 1 AASystemTable_Extend.UserId AS PRIMARYKEY_AASystemTable_Extend_1, AASystemTable_Extend.Firstname AS AASystemTable_Extendfield_1, AASystemTable_Extend.AvatarURL AS AASystemTable_Extendfield_2 FROM AASystemTable_ExtendedUserInfo AASystemTable_Extend\">\n<sqlCount=\"SELECT  Count(*)  FROM AASystemTable_ExtendedUserInfo AASystemTable_Extend\">\n<xbasicMap_captureParentSideOfOneToManyLinks=\"\">\n<refreshRowWhereClause=\"AASystemTable_Extend.UserId= :primaryKey_AASystemTable_Extend_1\">\n<rawDataInSection=<<%str%\n__varPrefix__.name = {s_quote((rs.data(\"AASystemTable_Extendfield_1\")))}\n__varPrefix__.image1 = {s_quote((rs.data(\"AASystemTable_Extendfield_2\")))}\n%str%>\n>\n<javascriptToRefreshAllControlsInSection=<<%str%\n{dialog.object}.originalValues[0]['NAME'] = '{js_escape(\"\"+rs.data(\"AASystemTable_Extendfield_1\"))}';\n{dialog.object}.originalValues[0]['IMAGE1'] = '{a5DialogHelper_BlobImages(rs.data(\"AASystemTable_Extendfield_2\"),\"<base64Encode=.F.><type=\\\"JPG\\\"><scale=\\\"\\\"><fileNameTransformation=\\\"\\\"><noImageFoundImage=\\\"<None>\\\"><newRecordImage=\\\"<None>\\\"><isIFR=.F.><isBlob=.F.>\",tmpl)}';\n\nif($('{dialog.componentname}.V.R1.IMAGE1_HIDDENA5FN')) $('{dialog.componentname}.V.R1.IMAGE1_HIDDENA5FN').value = '';\n%str%>\n<xBasicToSetOneToManyLinkArguments=\"\">\n>\n",

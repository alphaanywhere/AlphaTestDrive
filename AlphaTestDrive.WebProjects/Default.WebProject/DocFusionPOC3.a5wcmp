			"scriptMetaData": "<a_ajs<[1]<action=\"Display a 'Wait...' message.\">\r\n<icon=\"$$generic.hourGlass\">\r\n<isCommentedOut=.F.>\r\n<comment=\"\">\r\n<builder=\"a5ajs_waitMessage(v,wf,pv,dlg_mode)\">\r\n<metaData=<<%str%\r\n<lockWhat=\"Page\">\r\n<elementId=\"\">\r\n<containerId=\"\">\r\n<panelId=\"\">\r\n<useCSSAnimation=.F.>\r\n<message<text=\"Wait...\">\r\n<waitIcon=\"css/A5System/Images/wait.gif\">\r\n>\r\n<cssAnimation<size=\"32\">\r\n>\r\n<waitMessageAutoCloseDelay=\"10000\">\r\n%str%>\r\n<javascriptAttribute=\"{dialog.object}.showWaitMessage('page',{useCSSAnimation: false,message: 'Wait...',icon: 'css/A5System/Images/wait.gif',waitMessageAutoCloseDelay: 10000});\">\r\n<Javascriptdeclarations_row=\"\">\r\n<Javascriptdeclarations_global=\"\">\r\n<xbasicFunctions=\"\">\r\n<display=\"{I:'$$generic.hourGlass'}{F=Tahoma,10}{C=Dark Blue,White}{B=Blue White,Dark Blue}Display a 'Wait...' message.{T=4}{I:'a5_vertical_line'}\">\r\n<keep=.T.>\r\n>\r\n<[2]<display=\"{I:'$$edit.redo'}{F=Tahoma,10}{C=Dark Blue,White}{B=Blue White,Dark Blue}Ajax Callback   {T=4}{I:'a5_vertical_line'}\">\r\n<action=\"Ajax Callback   \">\r\n<icon=\"$$edit.redo\">\r\n<isCommentedOut=.F.>\r\n<comment=\"\">\r\n<builder=\"a5ajs_AjaxCallBack(v, dlg_mode, wf)\">\r\n<metaData=<<%str%\r\n<flagSubmitData=.T.>\r\n<part=\"Grid\">\r\n<GridRowNumber=\"{Grid.RowNumber}\">\r\n<ajaxCallbackType=\"InternalXbasicFunction\">\r\n<functionName=\"Call_DocFusionPDFGenerate\">\r\n<callbackURL=\"\">\r\n<callbackActionName=\"\">\r\n<otherData=\"\">\r\n<computeCurrentRowdata=.F.>\r\n<submitLocationInfo=.F.>\r\n<ajaxFailedJavascript=\"\">\r\n<offlineJavascript=\"alert('Internet connection not available');\">\r\n<afterCallbackCompleteJavascript=\"\">\r\n<locationHighAccuracy=.T.>\r\n<locationTimeout=15000>\r\n<locationMaxAge=30000>\r\n<ajaxcallbacktimeout=\"<Default>\">\r\n<ajaxRetryCount=\"\">\r\n<chunkedResponses<allow=.F.>\r\n<maxMessages=-1>\r\n<maxTime=600>\r\n>\r\n<submitListData=.T.>\r\n<checkifserveravailable=.T.>\r\n<serveravailabletimeout=2000>\r\n<servernotavailablejavascript=\"alert('The server is not available');\">\r\n<peformspeedtest=.F.>\r\n<amountofdatatosend=\".1MB\">\r\n<maxspeedtestduration=300>\r\n<poorconnectionJavascript=\"\">\r\n<submitcheckedrows=.F.>\r\n<submitcheckrowsForList=\"\">\r\n%str%>\r\n<javascriptAttribute=<<%str%\r\n\r\n{dialog.object}.ajaxCallback('','','Call_DocFusionPDFGenerate','','',{chunkedResponses: {allow: false},deviceOfflineFunction: function() { alert('Internet connection not available');  },submitListData: true,checkifserveravailable: true,serveravailabletimeout: 2000,onServerNotAvailable: function() { alert('The server is not available');}});%str%>\r\n<Javascriptdeclarations_row=\"\">\r\n<Javascriptdeclarations_global=\"\">\r\n<xbasicFunctions=\"\">\r\n<keep=.T.>\r\n>\r\n>\r\n<flagRunSynchronously=.F.>\r\n<flagWrapInTryCatch=.F.>\r\n<tryCatchJavascript=\"\">\r\n"
		}],

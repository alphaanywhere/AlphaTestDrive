		"dialogObject": "if(typeof {dialog.componentName}_DlgObj == 'object') {dialog.componentName}_DlgObj._destroy();\r\nvar {dialog.componentName}_DlgObj = new A5.DialogComponentHelper('{dialog.componentName}',{\r\n\tajaxURL: '{dialog.ajaxUrl}',\r\n\t_embeddedMode: {dialog.embeddedMode},\r\n\t_livePreviewInBuilder: {livePreviewInBuilder},\r\n\tcomponentGUID: '623cfeb5-514e-4acb-9a69-70233d085b35',\r\n\tcolumnInfo: {columninfo},\r\n\toriginalValues: {dialog.jsOriginalValues},\r\n\tdefaultValues: {dialog.jsDefaultValues},\r\n\tdatePickerMonthNames: [{datePickerMonthNames}],\r\n\tdatePickerDayNames: [{datePickerDayNames}],\r\n\tdatePickerTodayButton: '{datePickerTodayButton}',\r\n\tdatePickerCloseButton: '{datePickerCloseButton}',\r\n\tdatePickerFirstDayOfWeek: {datePickerFirstDayOfWeek},\r\n\tresetFormMessage: '{resetFormMessage}',\r\n\tresetFormTitle: '{resetFormTitle}',\r\n\tresetFormIcon: '{resetFormIcon}',\r\n\tdirtyFormMessage: '{dirtyFormMessage}',\r\n\tdirtyFormTitle: '{dirtyFormTitle}',\r\n\tdirtyFormIcon: '{dirtyFormIcon}',\r\n\tdeleteRecordDialogTitle: '{deleteRecordTitle}',\r\n\tdeleteRecordDialogMessage: '{deleteRecordMessage}',\t\r\n\tssDateFormat: '{serverSideDateFormat}',\r\n\tstyleName: '{dialog.style}',\r\n\t_fieldHelpers_DIALOG2: [],\r\n\tparentComponentAlias: '{parentComponentAlias}',\r\n\tsubmitIfHasClientSideErrors: false, \r\n\trowErrors: {\r\n\t\t\t\tshowMessageBox: false,\r\n\t\t\t\tmessageBoxTitle: 'Error',\r\n\t\t\t\tstyle: 'color: red; width: 6in; height: 2in;'\r\n\t\t},\r\n\tfieldErrors: {\r\n\t\ttype: 'block', \r\n\t\tclassName: 'errorText',\r\n\t\tinputClassName: '[class.gridInputError]',\r\n\t\tedit: { \r\n\t\t\tcontainer: { className: '[class.gridInputContainerError]'}\r\n\t\t},\r\n\t\ticon: '{images.dialog.editError}',\r\n\t\tglobal: {\r\n\t\t\tcontId: '{dialog.componentname}.GLOBALERRORS',\r\n\t\t\thoverClassName: 'errorTextHighlight',\r\n\t\t\thoverInputClassName: 'errorInputHighlight'\r\n\t\t}\r\n\t},\r\n\t\tonInitializeComplete: funct
vascript.onCompleteIndividualFile as C\r\nDIM p.uploadProperties.cloudStorage.javascript.onCompleteAllFiles as C\r\nDIM p.uploadProperties.cloudStorage.javascript.onBeforeFileSelect as C\r\nDIM p.uploadProperties.cloudStorage.javascript.onValidationError as C\r\nDIM p.uploadProperties.cloudStorage.javascript.onError as C\r\nDIM p.uploadProperties.cloudStorage.javascript.onProgress as C\r\nDIM p.uploadProperties.cloudStorage.javascript.targetName as C\r\nDIM p.uploadProperties.cloudStorage.customization as P\r\nDIM p.uploadProperties.cloudStorage.customization.maxFileSize as C = \"Selected file [filename] (size [filesize]) exceeds the maximum allowed file size of [maxfilesize].\"\r\nDIM p.uploadProperties.cloudStorage.customization.totalFileSize as C = \"Selected files ([filecount] files, total size [totalfilesize]) exceed the maximum allowed total file size of [maxtotalfilesize].\"\r\nDIM p.uploadProperties.cloudStorage.customization.fileType as C = \"Selected file ([filename]) is not an allowed file type.\"\r\nDIM p.uploadProperties.cloudStorage.targetFolder as C\r\nDIM p.uploadProperties.storeThumbnails as L\r\nDIM p.uploadProperties.thumbNailDefinition as C\r\nDIM p.uploadProperties.uploadFolder as C = \"profilePics\"\r\nDIM p.uploadProperties.fileExistAction as C = \"Overwrite\"\r\nDIM p.uploadProperties.storedValueExpression as C = \"\\\"profilePics/<ShortFilename>\\\"\"\r\nDIM p.uploadProperties.maxFileSize as C = \"1000000\"\r\nDIM p.uploadProperties.maxFileSizeExceededMessage as C = \"You have selected a file that exceeds the maximum allowed file size of {filesize} bytes.\"\r\nDIM p.uploadProperties.allowedImageExtensions as C = \".bmp,.jpg,.jpeg,.png\"\r\nDIM p.uploadProperties.invalidExtensionErrorText as C = \"The file you selected is not an allowed file type.\"\r\nDIM p.uploadProperties.sqlEmbeddedImageFormat as C = \"JPG\"\r\nDIM p.uploadProperties.title as C = \"Select File\"\r\nDIM p.uploadProperties.uploadButtonText as C = \"Upload\"\r\nDIM p.uploadP
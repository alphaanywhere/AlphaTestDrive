		{
			"actionGuid": "a8527b91-c5ef-491c-a835-68e447c8e231",
			"scriptMetaData": "<a_ajs<[1]<display=\"{I:'$$generic.key'}{F=Tahoma,10}{C=Dark Blue,White}{B=Blue White,Dark Blue}Get Primary Key values for Records in Query.  {T=4}{I:'a5_vertical_line'}\">\r\n<action=\"Get Primary Key values for Records in Query.  \">\r\n<icon=\"$$generic.key\">\r\n<isCommentedOut=.F.>\r\n<comment=\"\">\r\n<builder=\"a5ajs_GetPrimaryKeyList(v,wf,pv,dlg_mode)\">\r\n<metaData=<<%str%\r\n<maxNumberOfKeys=1000>\r\n<methodForSpecifyingTableFilter=\"SpecifyNow\">\r\n<filter=\"UserId  =  :USERID\">\r\n<order=\"\">\r\n<filterArguments=\"\">\r\n<clientSideEvents<beforeSearch=\"\">\r\n<afterSearch=\"\">\r\n>\r\n<baseFilter=\"\">\r\n<noRecordsInQueryAction=\"ShowAllRecords\">\r\n<noRecordsInQueryMessageShowAllOption=\"No records in query. Showing all records.\">\r\n<noRecordsInQueryMessageNewRecordOption=\"No records in query. Showing new record.\">\r\n<includePrimaryKeyDescription=.F.>\r\n<flagFieldsDefined=.F.>\r\n<sortFields=\"\">\r\n<showComputedQuery=.F.>\r\n<showQueryID=\"\">\r\n<combineCriteriaWith=\"AND\">\r\n<keywordSearch=.F.>\r\n<keywordControl=\"\">\r\n<keywordSearchFields=\"\">\r\n<flagDescriptionColumnsDefined=.F.>\r\n<showSlider=.F.>\r\n<sliderContainerId=\"\">\r\n<showSliderMessage=.T.>\r\n<sliderMessage=\"({recordNumber} of {recordcount}) &nbsp;<b>{PrimaryKeyDescription}</b> \">\r\n<sliderWidth=\"6in\">\r\n<sliderMessagePrefix=\"Record:\">\r\n<hideSliderMessageWhenMouseNotOverSlider=.F.>\r\n<sliderMessagePosition=\"Above\">\r\n<sliderOnSlideEventHandlerFunction=\"\">\r\n<sliderOnChangeEventHadlerFunction=\"\">\r\n<newRecordMessage=\"New\">\r\n<noRecordsMessage=\"No records\">\r\n<showSliderC=\"No\">\r\n<showlistView=.F.>\r\n<listViewContainerId=\"\">\r\n<height=\"4in\">\r\n<width=\"3in\">\r\n<initialMessage=\"Loading data....\">\r\n<hasFreeformDisplay=.F.>\r\n<freeFormTemplate=\"\">\r\n<freeFormTemplateColumnHeading=\"\">\r\n<fillPanelContainer=.T.>\r\n<targetPanelOnClick=\"<NextPanel>\">\r\n<javascript<onSelect=\"\">\r\n>\r\n<hasCustomListViewRecordNavigator=.F.>\r\n<customListViewNavigatorIds=\"\">\r\n<showListViewC=\"No\">\r\n<fields>\r\n<columns>\r\n%str%>\r\n<javascriptAttribute=\"{dialog.object}._functions.action_UnboundActionJavascript_7b713c7e_937b_4e27_a727_d41113c1e3d4();\">\r\n<Javascriptdeclarations_row=\"\">\r\n<Javascriptdeclarations_global=<<%str%\r\n{dialog.object}._functions.action_UnboundActionJavascript_7b713c7e_937b_4e27_a727_d41113c1e3d4 = function() {\r\nvar arr = [];\r\narr.push(A5.ajax.buildURLParam('__filter','UserId  =  :USERID'));\r\narr.push(A5.ajax.buildURLParam('__filterArgs',''));\r\narr.push(A5.ajax.buildURLParam('__order',''));\r\narr.push(A5.ajax.buildURLParam('__cs_aftersearch',''));\r\narr.push(A5.ajax.buildURLParam('__oi_maxKeys','1000'));\r\narr.push(A5.ajax.buildURLParam('__xbFunction','actionJavascript_UnboundActionJavascript_7b713c7e_937b_4e27_a727_d41113c1e3d4'));\r\narr.push(A5.ajax.buildURLParam('__combineMultipleCriteriaUsing','AND'));\r\n\r\nvar data = arr.join('&');\t\r\nvar xbasicFunction = 'system:ExecuteExplicitFilterThenGetPrimaryKeyList';\r\n{dialog.object}.ajaxCallback('G',1,xbasicFunction,'',data);\r\n\t\r\n};%str%>\r\n<xbasicFunctions=<<%str%\r\nfunction actionJavascript_UnboundActionJavascript_7b713c7e_937b_4e27_a727_d41113c1e3d4 as p ()\r\ndim xinfo as p\r\nxinfo.baseFilter = \"\"\r\nxinfo.showQuery = .f.\r\nxinfo.id = \"\"\r\nxinfo.noRecordsInQueryAction = \"ShowAll\"\r\nxinfo.noRecordsMessage = \"No records in query. Showing all records.\"\r\nactionJavascript_UnboundActionJavascript_7b713c7e_937b_4e27_a727_d41113c1e3d4 = xinfo\r\nend function \r\n%str%>\r\n<keep=.T.>\r\n>\r\n>\r\n<flagRunSynchronously=.F.>\r\n<flagWrapInTryCatch=.F.>\r\n<tryCatchJavascript=\"\">\r\n"
		},
		{
			"actionGuid": "9f3d71db-a91a-42ab-ae72-194f155b4eca",
			"scriptMetaData": "<a_ajs<<[1]<display=\"{I:'$$file.import'}{F=Tahoma,10}{C=Dark Blue,White}{B=Blue White,Dark Blue}Image Upload {T=4}{I:'a5_vertical_line'}\">\r\n<action=\"Image Upload \">\r\n<icon=\"$$file.import\">\r\n<isCommentedOut=.F.>\r\n<comment=\"\">\r\n<builder=\"a5ajs_imageFieldUpload(v,wf,pv,dlg_mode)\">\r\n<metaData=<<%str%\r\n<gridImageField=\"profilePic (C)\">\r\n<ajaxWindowPositionAttribute=\"\">\r\n<ajaxWindowPositionAttributeEnglish=\"\">\r\n<applicationType=\"Desktop\">\r\n<uploadProperties<target=\"Server\">\r\n<cloudStorage<specifyCredentials=\"Named Storage Connection String\">\r\n<connectionString=\"\">\r\n<credentials<access_key=\"\">\r\n<secret=\"\">\r\n>\r\n<bucketName=\"\">\r\n<region=\"\">\r\n<allowMultipleFiles=.F.>\r\n<maxFileSize=-1>\r\n<maxFileSizeTotal=-1>\r\n<allowedFileTypes=\"\">\r\n<authenticatedRead=.F.>\r\n<displayProgress=.F.>\r\n<allowCancel=.T.>\r\n<progressStyle=\"Bar\">\r\n<progressBarColor=\"#9fa1e8\">\r\n<progressBarWidth=\"1.5in\">\r\n<progressDisplayPlaceholder=\"\">\r\n<javascript<onAfterFilesSelect=\"\">\r\n<onCompleteIndividualFile=\"\">\r\n<onCompleteAllFiles=\"\">\r\n<onBeforeFileSelect=\"\">\r\n<onValidationError=\"\">\r\n<onError=\"\">\r\n<onProgress=\"\">\r\n<targetName=\"\">\r\n>\r\n<customization<maxFileSize=\"Selected file [filename] (size [filesize]) exceeds the maximum allowed file size of [maxfilesize].\">\r\n<totalFileSize=\"Selected files ([filecount] files, total size [totalfilesize]) exceed the maximum allowed total file size of [maxtotalfilesize].\">\r\n<fileType=\"Selected file ([filename]) is not an allowed file type.\">\r\n>\r\n<targetFolder=\"\">\r\n>\r\n<storeThumbnails=.F.>\r\n<thumbNailDefinition=\"\">\r\n<uploadFolder=\"profilePics\">\r\n<fileExistAction=\"Overwrite\">\r\n<storedValueExpression=\"\\\"profilePics/<ShortFilename>\\\"\">\r\n<maxFileSize=\"1000000\">\r\n<maxFileSizeExceededMessage=\"You have selected a file that exceeds the maximum allowed file size of {filesize} bytes.\">\r\n<allowedImageExtensions=\".bmp,.jpg,.jpeg,.png\">\r\n<invalidExtensionErrorText=\"The file you selected is not an allowed file type.\">\r\n<sqlEmbeddedImageFormat=\"JPG\">\r\n<title=\"Select File\">\r\n<uploadButtonText=\"Upload\">\r\n<fileBoxWaterMark=\"Click button to select file...\">\r\n<selectFileButtonImage=\"images/$$folder.open.png.a5image\">\r\n<prompt=\"File:\">\r\n<height=\"3in\">\r\n<width=\"5in\">\r\n<fileUploadWaitMessage=\"<img src=\\\"css/A5System/Images/wait.gif\\\" /> Uploading files...\">\r\n<windowSubtheme=\"\">\r\n<scaleImage=\"\">\r\n<closeAfterUpload=.T.>\r\n<confirmationMessage=\"Image was uploaded. Click OK to save change, or Cancel to abandon change.\">\r\n<confirmationWindowHasFreeformLayout=.F.>\r\n<confirmationWindowTemplate=\"\">\r\n<imageInlineStyle=\"height: 1in;\">\r\n<autoUpload=.F.>\r\n<targetFileNameAfterComputeXbasic=\"\">\r\n<errorText_TableNotUpdateable=\"Table is not updateable, or you do not have permission to update this table.\">\r\n<errorText_FieldNotUpdateable=\"Image field is not updateable, or you do not have permission to update this field.\">\r\n<errorText_SessionExpired=\"Session has expired, or some other error has occurred, and the uploaded image cannot be found. Please upload the image again.\">\r\n<errorText_NewRecordRow=\"You cannot upload an image to a new record row. You must first save this record, then upload the image.\">\r\n<events<serverside<beforeSave=\"\">\r\n<onSave=\"\">\r\n>\r\n<clientSide<afterUpload=\"\">\r\n<beforeUpload=\"\">\r\n>\r\n>\r\n<fileSelectWindowName=\"29417d58ec484de49ccef1cc1d53616a\">\r\n<showProgress=.T.>\r\n<uploadAbortMsg=\"Abort file upload\">\r\n<abortButtonLabel=\"Abort\">\r\n<progressBarType=\"A5\">\r\n<targetField=\"profilePic\">\r\n<targetFieldIsBlob=.F.>\r\n>\r\n<mobileType=\"HTML5\">\r\n<html5<resizeAndCompress=.T.>\r\n<compressionFactor=\"0.5\">\r\n<maxWidth=\"1024\">\r\n<maxHeight=\"1024\">\r\n>\r\n<cordova<usingPhoneGapBuild=.T.>\r\n<pictureSource=\"Camera\">\r\n<imageQ
                    },
                    "abstractJavascriptDeclarationsGlobal": {
                        "click": "{dialog.object}._functions.BUTTON_5_ACTIONBUTTON_1 = function(objEle) {\n\n\nif({grid.object}._embeddedMode) {\n\talert('File upload is not supported when the Component is running on the Desktop.');\n\treturn false;\n}\n\n\nvar rowNum = 1;\nvar instanceNumber = {dialog.object}.getInstanceNumber('url');\n\n\nwindow['{Dialog.ComponentName}_ACTIONBUTTON_hgbff'] = {Dialog.object}.createWindow('{Dialog.componentName}_WINDOW_ACTIONBUTTON_hgbff','modal-url',\n{\theight: '3in',\n\twidth: '5in',\n\ttitle: {html: 'Select File<span id=\"a3f7246e8f5b40e4b2396edfadb46d98\"></span>' },\n\ttheme: '{Dialog.style}',\n\tbody: {content: {type: 'url',\n\turl: 'about:blank'}},\n\tbuttons: {\n\t\titems: [\n\t\t\t{html: '<div style=\"width:1in;cursor:default;\">Upload</div>', width: '', name: 'UPLOAD', action: function() {$(this.getWindowId('body')).contentWindow.A5.fileUpload.upload(); }},\n\n\t\t\t{html: '<div style=\"width:1in;cursor:default;\">OK</div>', width: '', name: 'OK', action: function() {$(this.getWindowId('body')).contentWindow.okToSave(); }},\n\t\t\t{html: 'Cancel',width: '', name: 'Cancel', action: function() { this.hide(); } }\n\t\t]\n\t},\n\tonHide: function() { var ele = $('{dialog.componentname}.V.R'+1+'.URL');\nvar oldImg = $ga(ele,'oldImage');\nif(oldImg) $svs(ele,oldImg);\n  ; this.refresh(); }\n}\n);\n\nwindow['{Dialog.ComponentName}_ACTIONBUTTON_hgbff'].clearTools();\nwindow['{Dialog.ComponentName}_ACTIONBUTTON_hgbff'].setButtonDisplay('OK',false);\nwindow['{Grid.ComponentName}_ACTIONBUTTON_hgbff'].setButtonDisplay('UPLOAD',true);\n\nwindow['{Dialog.ComponentName}_ACTIONBUTTON_hgbff'].getButton('Cancel').refresh();\nwindow['{Dialog.ComponentName}_ACTIONBUTTON_hgbff'].show();\nwindow['{Dialog.ComponentName}_ACTIONBUTTON_hgbff'].rowNumber = rowNum;\n\nvar data = '';\nvar __additionalInfo = ''\n\n\nvar targetUrl = '';\ntargetUrl = targetUrl + '__a5FileUploadMasterPage.a5w?fileUploadUrl=' + urlencode({Dialog.object}.ajaxURL) + '&__add
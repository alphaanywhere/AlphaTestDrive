                "scriptMetaData": "<a_ajs<[1]<display=\"{I:'$$generic.key'}{F=Tahoma,10}{C=Dark Blue,White}{B=Blue White,Dark Blue}Get Primary Key values for Records in Query.  {T=4}{I:'a5_vertical_line'}\">\n<action=\"Get Primary Key values for Records in Query.  \">\n<icon=\"$$generic.key\">\n<isCommentedOut=.F.>\n<comment=\"\">\n<builder=\"a5ajs_GetPrimaryKeyList(v,wf,pv,dlg_mode)\">\n<metaData=<<%str%\n<maxNumberOfKeys=1000>\n<methodForSpecifyingTableFilter=\"SpecifyNow\">\n<filter=\"\">\n<order=\"\">\n<filterArguments=\"\">\n<clientSideEvents<beforeSearch=\"\">\n<afterSearch=\"\">\n>\n<baseFilter=\"\">\n<noRecordsInQueryAction=\"ShowAllRecords\">\n<noRecordsInQueryMessageShowAllOption=\"No records in query. Showing all records.\">\n<noRecordsInQueryMessageNewRecordOption=\"No records in query. Showing new record.\">\n<includePrimaryKeyDescription=.F.>\n<flagFieldsDefined=.F.>\n<sortFields=\"\">\n<showComputedQuery=.F.>\n<showQueryID=\"\">\n<combineCriteriaWith=\"AND\">\n<keywordSearch=.F.>\n<keywordControl=\"\">\n<keywordSearchFields=\"\">\n<flagDescriptionColumnsDefined=.F.>\n<showSlider=.F.>\n<sliderContainerId=\"\">\n<showSliderMessage=.T.>\n<sliderMessage=\"({recordNumber} of {recordcount}) &nbsp;<b>{PrimaryKeyDescription}</b> \">\n<sliderWidth=\"6in\">\n<sliderMessagePrefix=\"Record:\">\n<hideSliderMessageWhenMouseNotOverSlider=.F.>\n<sliderMessagePosition=\"Above\">\n<sliderOnSlideEventHandlerFunction=\"\">\n<sliderOnChangeEventHadlerFunction=\"\">\n<newRecordMessage=\"New\">\n<noRecordsMessage=\"No records\">\n<showSliderC=\"No\">\n<showlistView=.F.>\n<listViewContainerId=\"\">\n<height=\"4in\">\n<width=\"3in\">\n<initialMessage=\"Loading data....\">\n<hasFreeformDisplay=.F.>\n<freeFormTemplate=\"\">\n<freeFormTemplateColumnHeading=\"\">\n<fillPanelContainer=.T.>\n<targetPanelOnClick=\"<NextPanel>\">\n<javascript<onSelect=\"\">\n>\n<hasCustomListViewRecordNavigator=.F.>\n<customListViewNavigatorIds=\"\">\n<showListViewC=\"No\">\n<fields>\n<columns>\n%str%>\n<javascriptAttribute=\"{dialog.object}._functions.action_UnboundActionJavascript_ceb42605_6ea7_484e_9731_9610c59872e7();\">\n<Javascriptdeclarations_row=\"\">\n<Javascriptdeclarations_global=<<%str%\n{dialog.object}._functions.action_UnboundActionJavascript_ceb42605_6ea7_484e_9731_9610c59872e7 = function() {\nvar arr = [];\narr.push(A5.ajax.buildURLParam('__filter',''));\narr.push(A5.ajax.buildURLParam('__filterArgs',''));\narr.push(A5.ajax.buildURLParam('__order',''));\narr.push(A5.ajax.buildURLParam('__cs_aftersearch',''));\narr.push(A5.ajax.buildURLParam('__oi_maxKeys','1000'));\narr.push(A5.ajax.buildURLParam('__xbFunction','actionJavascript_UnboundActionJavascript_ceb42605_6ea7_484e_9731_9610c59872e7'));\narr.push(A5.ajax.buildURLParam('__combineMultipleCriteriaUsing','AND'));\n\nvar data = arr.join('&');\t\nvar xbasicFunction = 'system:ExecuteExplicitFilterThenGetPrimaryKeyList';\n{dialog.object}.ajaxCallback('G',1,xbasicFunction,'',data);\n\t\n};%str%>\n<xbasicFunctions=<<%str%\nfunction actionJavascript_UnboundActionJavascript_ceb42605_6ea7_484e_9731_9610c59872e7 as p ()\ndim xinfo as p\nxinfo.baseFilter = \"\"\nxinfo.showQuery = .f.\nxinfo.id = \"\"\nxinfo.noRecordsInQueryAction = \"ShowAll\"\nxinfo.noRecordsMessage = \"No records in query. Showing all records.\"\nactionJavascript_UnboundActionJavascript_ceb42605_6ea7_484e_9731_9610c59872e7 = xinfo\nend function \n%str%>\n>\n>\n<flagRunSynchronously=.F.>\n<flagWrapInTryCatch=.F.>\n<tryCatchJavascript=\"\">\n"
            },

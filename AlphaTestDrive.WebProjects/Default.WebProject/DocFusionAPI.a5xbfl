function GeneratePDFFile as c (e as p)
	'debug(1)
	dim base64file as c = ""
	
	dim decodedFile as b
	decodedFile = base64decode(base64file)
	'dim filename as c = "MyFile1.pdf"
	dim filename as c = context.request.GetRequestTempFileName(".pdf")
	FILE.from_blob(filename, decodedFile)
	dim mime as c = "application/pdf"
	
	dim clientsideFilename as c = "MyReport.pdf"
	dim componentAlias as c
	componentAlias = e.tmpl.alias
	
	' Generate the javascript response to send the file
	dim js as c
	js = a5Helper_generateFileDownloadJS(componentAlias, filename, clientsideFilename)
	
	GeneratePDFFile = js

end function 

function DocFusion_Authenticate as p(e as p,client_id as c,client_secret as c)
	
	'debug(1)	
	'====== START == cURL call to DocFusion REST API ============
	dim cf_1 as extension::CurlFile
	dim flag_1 as l
	dim slist1[0] as c = [ "content-type: application/x-www-form-urlencoded" ]
	dim ce as extension::Curl
	
	dim response as p	
	ce = extension::Curl.Init()
	ce.setOpt("BUFFERSIZE",102400)
	ce.setOpt("URL","https://online.docfusion-paas.com/core/connect/token")
	dim posted_fields as c = ("client_id="+client_id+"&client_secret="+client_secret+"&grant_type=client_credentials&scope=DocFusion&resource=DocFusion")
	ce.setOpt("POSTFIELDS",posted_fields)
	ce.setOpt("POSTFIELDSIZE_LARGE", len(posted_fields) )
	ce.setOpt("HTTPHEADER",slist1)
	ce.setOpt("USERAGENT","curl/7.81.0")
	ce.setOpt("FOLLOWLOCATION",1)
	ce.setOpt("MAXREDIRS",50)
	ce.setOpt("CAINFO",a5http_CARootsFile())
	ce.setOpt("CAPATH",file.filename_parse(a5http_CARootsFile(),"dp"))
	ce.setOpt("PROXY_CAPATH",file.filename_parse(a5http_CARootsFile(),"dp"))
	ce.setOpt("FTP_SKIP_PASV_IP",1)
	ce.setOpt("TCP_KEEPALIVE",1)
	ce.SetOpt("FILE",cf_1)
	flag_1 = ce.Exec()
	if flag_1 then	
		
	    dim headers as c
		dim contents as c
		headers = cf_1.GetHeaders()
		contents = cf_1.GetContent()
	
		'BE SURE TO COMMENT OUT THIS CODE IN A WEB APPLICATION AS showVar() CANNOT BE USED IN WEB APPLICATIONS
		dim msg as c
		msg = "Headers: " + crlf() + headers + crlf() + "Content: " + contents		
		response = json_parse(contents)	
		
	else
		dim errors as c
		errors = ce.error()	
		'BE SURE TO COMMENT OUT THIS CODE IN A WEB APPLICATION AS showVar() CANNOT BE USED IN WEB APPLICATIONS
		'showvar("error: " + errors)
		response.cURLerror = errors
	end if
	ce.close()
	'====== END == cURL call to DocFusion REST API ============
	
	DocFusion_Authenticate = response
	
end function


function DocFusion_GenerateDocument as p (e as p,json_string as c,ClientID as c,ClientSecret as c,BusinessUnitGuid as c,TemplateGuid as c,ChainGuid as c,WorkflowProcessGuid as c = "")
	
	'debug(1)	
	dim authResp as p
	'authResp = DocFusion_Authenticate(e,e.DATASUBMITTED.CLIENT_ID,e.DATASUBMITTED.CLIENT_SECRET)
	authResp = DocFusion_Authenticate(e,ClientID,ClientSecret)
	
	if eval_valid("authResp.error") then
		'Goto Error
		dim errorMsg as c
		errorMsg = authResp.error
		jsStr = system_msgbox("DocFusion Error",js_Escape(errorMsg),"E")
		DocFusion_GenerateDocument = jsStr + "{dialog.object}.hideWaitMessage();"
		end
	end if	
	
	if eval_valid("authResp.cURLerror") then
		'Goto Error
		dim errorMsg as c
		errorMsg = authResp.error
		jsStr = system_msgbox("Alpha cURL Error | DocFusion_GenerateDocument",js_Escape(errorMsg),"E")
		DocFusion_GenerateDocument = jsStr + "{dialog.object}.hideWaitMessage();"
		end
	end if		

	dim base64_encoded_string as C
	base64_encoded_string = base64Encode(json_string)
	
	dim jsStr as c	
	dim response as p

	'====== START == cURL call to DocFusion REST API ============
	dim cf_1 as extension::CurlFile
	dim flag_1 as l
	
	bearerToken = authResp.access_token
	dim slist1[0] as c =  [ "Authorization: Bearer " + bearerToken , "Content-Type: application/json" ]
	dim ce as extension::Curl
	
	ce = extension::Curl.Init()
	ce.setOpt("BUFFERSIZE",102400)
	ce.setOpt("URL","https://online.docfusion-paas.com/api/DocFusionV2/GenerateDocumentFull")
	dim jsonDataPayload as c
	
'	jsonDataPayload = <<%json%
'	{
'	  "Source": "",
'	  "JobReference": "",
'	  "Process": {
'	    "ProcessType": "Process",
'	    "BusinessUnitGuid": "__BusinessUnitGuid__",
'	    "WorkflowProcessGuid" : "__WorkflowProcessGuid__",
'		"TemplateGuid": "__TemplateGuid__",
'	    "ChainGuid": "__ChainGuid__",
'	    "ProcessAsync": false,
'	    "ReturnData": "JSON"
'	  },
'	  "Timeout": "00:01:00",
'	  "Data": {
'	    "DataType": "JSON",
'		"DataProcessor": "",
'	    "Data": "__base64encoded_data__",
'	    "ProcessorProfile": ""
'	  },
'	  "Parameters": { 
'	      "Reference":"Alpha Anywhere Test"}
'	}
'	%json%

	jsonDataPayload = <<%json%
	{
	  "Source": "",
	  "JobReference": "",
	  "Process": {
        "ProcessType": 0,
        "BusinessUnitGuid": "__BusinessUnitGuid__",
        "TemplateGuid": "__TemplateGuid__",
        "TemplateVersion": null,
        "ChainGuid": "__ChainGuid__",
        "ChainVersion": null,
        "WorkflowProcessGuid": "",
        "WorkflowProcessVersion": null,
        "ProcessAsync": false
	  },
	  "Timeout": "00:01:00",
	  "Data": {
	    "DataType": "JSON",
		"DataProcessor": "",
	    "Data": "__base64encoded_data__",
	    "ProcessorProfile": ""
	  },
	  "Parameters": { 
	      "Reference":"Alpha Anywhere Test"}
	}
	%json%
	
	jsonDataPayload = stritran(jsonDataPayload,"__base64encoded_data__",base64_encoded_string)	
	jsonDataPayload = stritran(jsonDataPayload,"__BusinessUnitGuid__",BusinessUnitGuid)
	jsonDataPayload = stritran(jsonDataPayload,"__WorkflowProcessGuid__",WorkflowProcessGuid)
	jsonDataPayload = stritran(jsonDataPayload,"__TemplateGuid__",TemplateGuid)
	jsonDataPayload = stritran(jsonDataPayload,"__ChainGuid__",ChainGuid)
	
	dim posted_fields as c = (jsonDataPayload)
	ce.setOpt("POSTFIELDS",posted_fields)
	ce.setOpt("POSTFIELDSIZE_LARGE", len(posted_fields) )
	ce.setOpt("HTTPHEADER",slist1)
	ce.setOpt("USERAGENT","curl/7.81.0")
	ce.setOpt("FOLLOWLOCATION",1)
	ce.setOpt("MAXREDIRS",50)
	ce.setOpt("CAINFO",a5http_CARootsFile())
	ce.setOpt("CAPATH",file.filename_parse(a5http_CARootsFile(),"dp"))
	ce.setOpt("PROXY_CAPATH",file.filename_parse(a5http_CARootsFile(),"dp"))
	ce.setOpt("FTP_SKIP_PASV_IP",1)
	ce.setOpt("TCP_KEEPALIVE",1)
	ce.SetOpt("FILE",cf_1)
	flag_1 = ce.Exec()
	if flag_1 then
	
	    dim headers as c
		dim contents as c
		headers = cf_1.GetHeaders()
		contents = cf_1.GetContent()	

		dim msg as c
		msg = "Headers: " + crlf() + headers + crlf() + "Content: " + contents

		if contents = "\"Unauthorised access\"" then
			' Re-Iterate Call if Access Denied
			DocFusion_GenerateDocument(e,json_string)
			end
		end if

		response = json_parse(contents)
	
	else
		dim errors as c
		errors = ce.error()
		response.errors = errors
	end if
	ce.close()
	'====== END == cURL call to DocFusion REST API ============

	DocFusion_GenerateDocument = response
	
end function


function Base64ToPDFFile as c (Base64DocumentData as c)
	
	'debug(1)	
	' Convert Base64 data to blob
	dim decodedFile as b
	decodedFile = base64decode(Base64DocumentData)
	
	' Set a filename for the PDF
	dim filename as c = context.request.GetRequestTempFileName(".pdf")
	
	' Generate the PDF file with the blob data
	FILE.from_blob(filename, decodedFile)
	Base64ToPDFFile = filename

end function 


function system_msgbox AS C (title as C, msg AS C, msg_type AS C )
	
	'debug(1)
	'the purpose of this function is to return an a5.msgbox.string with the passed in msg and surrounding HTML
	'The function uses msg_type to format the box in accordance with different message types.	
	dim str_format_html as C = ""
	dim str_closing_tag as C = ""
	
	' Set formatting for message
	if msg_type = "!"		' Warning message
		str_format_html = "<div style=\"color: black; background-color: yellow; width: 300px;\">"
		str_closing_tag = "</div>"
		
		if title = ""
			title = "<div style=\"text-align:left; font-weight:bold;\"><img src=\"images/$$generic.warning.png.a5image\"> Warning! </div>"
		else
			title = "<div style=\"text-align:left; font-weight:bold;\"><img src=\"images/$$generic.warning.png.a5image\"> " + js_escape(title) +"! </div>"
		end if
		
	else if msg_type = "E"	' Error message
		str_format_html = "<div style=\"color: black; background-color: white; width: 300px;\">"
		str_closing_tag = "</div>"
		
		if title = "" 
			title = "<div style=\"text-align:left; font-weight:bold;\"><img src=\"images/$$generic.stop.png.a5image\"> Error! </div>"
		else
			title = "<div style=\"text-align:left; font-weight:bold;\"><img src=\"images/$$generic.stop.png.a5image\"> " + js_escape(title) +"! </div>"
		end if

	else 'Alert message
		str_format_html = "<div style=\"width: 300px;\">"
		str_closing_tag = "</div>"
		
		if title = ""
			title = "<div style=\"text-align:left; font-weight:bold;\"> Alert! </div>"
		end if

	end if
	
	dim str_msg as C = msg
	dim str_string_pre as C = "A5.msgBox.show('" + js_escape(title) + "','" + alltrim(str_format_html) + "<br>&nbsp;&nbsp;" 
	dim str_string_post as C = "&nbsp;&nbsp;<br><br>" + alltrim(str_closing_tag) + "','o');"
	
	dim str_return_string as C
	str_return_string = str_string_pre + js_escape(str_msg) + str_string_post	
	system_msgbox = str_return_string
	
end function

function DocFusion_Template_JSON as c (templateGUID as c, e as p)
	
	'debug(1)
	dim conn as SQL::Connection
	dim rs as SQL::ResultSet
	dim sql as C
	dim args as SQL::Arguments
	
	dim json_string as c 
	
	
	'KB_Template_1  / Generation Sample Template
	if templateGUID = "766e0a23-1150-42ec-82c3-d6ffee1acddb" .or. templateGUID = "afd6e39e-0471-4633-b26c-d3da1a9eb47e" then
		
		json_string = <<%str%
			{
				"Firstname":"__fname__",
				"Lastname":"__lname__",
			}
		%str%
		
		args.add("customer_id", e.DATASUBMITTED.CUSTOMERS)
		sql = <<%str%
			SELECT 
				first_name,
				last_name
			FROM Customers
			WHERE customer_id = :customer_id;
		%str%

		conn.open("::Name::Conn")
		conn.execute(sql, args)
		rs = conn.ResultSet
		json_string = stritran(json_string,"__fname__",rs.data("first_name"))
		json_string = stritran(json_string,"__lname__",rs.data("last_name"))
		conn.close()	
		
	end if
	
	'Order Report
	if templateGUID = "33e46f6d-dba5-48cb-b965-28f067b5b6af" then
		
		json_string = <<%str%
			{
				"Firstname":"__fname__",
				"Lastname":"__lname__",
				"OrderID":"ORDER___order_id__",
				"Order_Items":[
					__order_items__
					]
			}
		%str%

		args.add("customer_id", e.DATASUBMITTED.CUSTOMERS)
		args.add("order_id", e.DATASUBMITTED.ORDERS)
		sql = <<%str%
			SELECT 
				DISTINCT
				first_name,
				last_name,
				Orders.order_id AS order_id
			FROM Order_Items
			LEFT OUTER JOIN Orders ON Orders.order_id = Order_Items.order_id
			LEFT OUTER JOIN Customers ON Customers.customer_id = Orders.customer_id
			WHERE Orders.order_id = :order_id AND Customers.customer_id = :customer_id;
		%str%
		
		conn.open("::Name::Conn")
		conn.execute(sql, args)
		rs = conn.ResultSet
		json_string = stritran(json_string,"__fname__",rs.data("first_name"))
		json_string = stritran(json_string,"__lname__",rs.data("last_name"))
		json_string = stritran(json_string,"__order_id__",convert_typE(rs.data("order_id"),"c"))
	
		delete rs
		sql = <<%str%
			SELECT 
					product_name AS ItemName,
					quantity AS ItemQty,
					unit_price AS ItemRate,
					(quantity * unit_price) AS ItemPrice
			FROM Order_Items
			LEFT OUTER JOIN Orders ON Orders.order_id = Order_Items.order_id
			LEFT OUTER JOIN Customers ON Customers.customer_id = Orders.customer_id
			WHERE Orders.order_id = :order_id AND Customers.customer_id = :customer_id;
		%str%
		conn.execute(sql, args)
		rs = conn.ResultSet
		txt = rsToJSON(rs)
		txt = crlf_to_comma(txt)
		json_string = stritran(json_string,"__order_items__",txt)
	
		conn.close()	
	
	end if

	'Customer Report
	if templateGUID = "45fd7052-2e92-4ab1-b50b-6c353e35d151" then
		
		json_string = <<%str%
			{
			  "CustomerList": [
			   __customer_records__
			  ]
			}	
		%str%
	
		conn.open("::Name::Conn")
		delete rs
		sql = <<%str%
			SELECT 
				first_name as Firstname,
				last_name as Lastname,
				address as Address,
				city as City,
				state as State,
				zip as Zip
			FROM Customers
		%str%
		conn.execute(sql, args)
		rs = conn.ResultSet
		txt = rsToJSON(rs)
		txt = crlf_to_comma(txt)
		json_string = stritran(json_string,"__customer_records__",txt)
	
		conn.close()	
	
	end if	

	'Large Data Model - Test 1
	if templateGUID = "d4c72c0e-e3dc-48cd-bb73-bafb25232264" then
		
		json_string = <<%str%
			{
		    "CustomerList": [
			   __customer_records__
			  ],
					"Firstname":"__fname__",
				"Lastname":"__lname__",
				"OrderID":"ORDER___order_id__",
				"Order_Items":[
					__order_items__
					],
		  "SubTotal": "0"
		}
		%str%
	
		conn.open("::Name::Conn")
		delete rs
		sql = <<%str%
			SELECT 
				first_name as Firstname,
				last_name as Lastname,
				address as Address,
				city as City,
				state as State,
				zip as Zip
			FROM Customers
		%str%
		conn.execute(sql, args)
		rs = conn.ResultSet
		txt = rsToJSON(rs)
		txt = crlf_to_comma(txt)
		json_string = stritran(json_string,"__customer_records__",txt)


		delete rs
		args.add("customer_id", e.DATASUBMITTED.CUSTOMERS)
		args.add("order_id", e.DATASUBMITTED.ORDERS)
		sql = <<%str%
			SELECT 
				DISTINCT
				first_name,
				last_name,
				Orders.order_id AS order_id
			FROM Order_Items
			LEFT OUTER JOIN Orders ON Orders.order_id = Order_Items.order_id
			LEFT OUTER JOIN Customers ON Customers.customer_id = Orders.customer_id
			WHERE Orders.order_id = :order_id AND Customers.customer_id = :customer_id;
		%str%
		
		conn.open("::Name::Conn")
		conn.execute(sql, args)
		rs = conn.ResultSet
		json_string = stritran(json_string,"__fname__",rs.data("first_name"))
		json_string = stritran(json_string,"__lname__",rs.data("last_name"))
		json_string = stritran(json_string,"__order_id__",convert_typE(rs.data("order_id"),"c"))


		delete rs
		sql = <<%str%
			SELECT 
					product_name AS ItemName,
					quantity AS ItemQty,
					unit_price AS ItemRate,
					(quantity * unit_price) AS ItemPrice
			FROM Order_Items
			LEFT OUTER JOIN Orders ON Orders.order_id = Order_Items.order_id
			LEFT OUTER JOIN Customers ON Customers.customer_id = Orders.customer_id
			WHERE Orders.order_id = :order_id AND Customers.customer_id = :customer_id;
		%str%
		conn.execute(sql, args)
		rs = conn.ResultSet
		txt = rsToJSON(rs)
		txt = crlf_to_comma(txt)
		json_string = stritran(json_string,"__order_items__",txt)

	
		conn.close()	
	
	end if	


	'Large Data Model - Only Customer List
	if templateGUID = "9b269741-1dae-4e60-8338-d57fc7ed9147" then
		
		json_string = <<%str%
		{
		    "CustomerList": [
			   __customer_records__
			  ],
				"Firstname":null,
				"Lastname":null,
				"OrderID":null,
				"Order_Items":null,
		        "SubTotal": "0"
		}
		%str%
	
		conn.open("::Name::Conn")
		delete rs
		sql = <<%str%
			SELECT 
				first_name as Firstname,
				last_name as Lastname,
				address as Address,
				city as City,
				state as State,
				zip as Zip
			FROM Customers
		%str%
		conn.execute(sql, args)
		rs = conn.ResultSet
		txt = rsToJSON(rs)
		txt = crlf_to_comma(txt)
		json_string = stritran(json_string,"__customer_records__",txt)
	
		conn.close()	
	
	end if		

	DocFusion_Template_JSON = json_string
end function



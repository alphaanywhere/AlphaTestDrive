				"DesignViewHTML": "",
				"pageLayoutPartJavascript": "{dialog.object}._functions.runAction_63439697_c087_4975_af0b_660ef71036f7 = function(obj) {\r\n\t\r\n\t\r\n\r\n\r\n\tvar go = {};\r\n\tvar panelCardId = {dialog.object}.panelGetId('PC_1','body');\r\nif($(panelCardId + '.SCROLLWRAPPER')) panelCardId = panelCardId + '.SCROLLWRAPPER';\r\ngo.dialog2Div = panelCardId;\r\n\t\t\r\n\r\n\tvar flagOKToRender = true;\r\n\t\r\n\t\r\n\tvar onCompleteCode = '';\r\n\tvar callbackId = A5.UUID();\r\n\tvar objx = {dialog.object}._ajaxCallbackCompleteCode;\r\n\tif(typeof objx == 'undefined') objx = {};\r\n\tobjx[callbackId] = Function(onCompleteCode);\r\n\tvar go = new Object();\r\n\t\tgo.dialog2Name = 'DocFusionPOC1';\r\n\tgo.type = 'dialog2';\r\n\t\r\n\tgo.alias = '{alias}_DOCFUSIONP_84827JJFG';\r\n\t\r\n\t\r\n\t\r\n\t\r\n\tgo.workingMessage = '<img src=\"css/A5System/Images/wait.gif\" /> Working...';\r\n\tgo.flagTimer = 'F';\r\n\tgo.flagQueryEcho = 'F';\r\n\tgo.flagDebugMode = 'F';\r\n\tgo.userFilter = '';\r\n\tgo.baseFilter = '';\r\n\tgo.userOrder = '';\r\n\tgo.overrideSettings = 'style_name=`{pageLayout.style}`'+'||';\r\n\tgo.arguments = '';\r\n\t\r\n\t\r\n\t\t\r\n\r\n//embedded objects on a ux can be refreshed or reloaded. the function that renders the embedded object can be \r\n//called with an optional argument (true=reload). defaults to false, which does a refresh (on a grid)\r\n\r\nvar flagReload = false;\r\nif(typeof arguments[0] != 'undefined' && arguments[0] == true) {\r\n\tflagReload = true\r\n}\r\nif (flagReload) go.__useCachedGrid = false;\r\nelse go.__useCachedGrid = true;\r\n\r\n\r\n\tgo.localArguments = '';\r\n\tgo.linkDefinition = '';\r\n\tgo.placeHolderValues = '';\r\n\tgo.parameterBucket = $gvs('{alias}.PARAMETERBUCKET');\r\n\tgo.argumentValueBucket = $gvs('{alias}.ARGUMENTVALUES');\r\n\tgo.a5_default_path = '{PageLayout.a5_default_path}';\r\n\tgo.onLoadCompleteJavascript = 'run:'+callbackId;\r\n\t\r\n\tgo._runningInMobilePreview = {dialog.object}._mobilePreview;\r\n\t\r\n\tif(typeof tbiObj != 'undefined' && typeof tbiObj._workingPreviewHost != 'undefined') { \r\n\t\tgo._workingPreviewHost = tbiObj._workingPreviewHost;\r\n\t}\r\n\t\r\n\tif(typeof obj != 'undefined') { \r\n\t\tfor(var n in obj) { \r\n\t\t\tgo[n] = obj[n]\r\n\t\t}\r\n\t}\r\n\t\r\n\t\r\n\r\n\tif(typeof {grid.object}.gridId != 'undefined') go._thisGridAlias = {grid.object}.gridId;\r\n\tif(typeof {grid.object}.dialogId != 'undefined') go._thisGridAlias = {grid.object}.dialogId;\r\n\t\r\n\t\r\n\t//debugger;\r\n\t\r\n\tvar po = window[go._thisGridAlias + '_DlgObj'];\r\n\tif(po) { \r\n\t\tif(typeof po._embeddedUX == 'undefined') po._embeddedUX = [];\r\n\t\tpo._embeddedUX.push(go.alias);\r\n\t\t//alert(po._embeddedUX);\r\n\t\t\r\n\t}\r\n\t\r\n\t\r\n\r\n\tvar panelCardId = {dialog.object}.panelGetId('PC_1','body');\r\nif($(panelCardId + '.SCROLLWRAPPER')) panelCardId = panelCardId + '.SCROLLWRAPPER';\r\ngo.dialog2Div = panelCardId;\r\n\t\t\r\n\tvar flag = true; if(typeof flagOKToRender != 'undefined') flag = flagOKToRender;  flag = true;  if(flag) { A5.component.runGenericComponent(go);}\r\n\t\r\n}\r\n"

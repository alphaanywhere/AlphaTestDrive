                "scriptMetaData": "<a_ajs<[1]<action=\"Run Action\">\n<icon=\"$$code.action.run\">\n<isCommentedOut=.F.>\n<comment=\"\">\n<builder=\"a5ajs_runAction(wf,v,dlg_mode)\">\n<metaData=<<%str%\n<actionName=\"GenerateReport\">\n<passInThis=.t.>%str%>\n<javascriptAttribute=\"{dialog.object}.runAction('GenerateReport');\">\n<Javascriptdeclarations_row=\"\">\n<Javascriptdeclarations_global=\"\">\n<xbasicFunctions=\"\">\n<display=\"{I:'$$code.action.run'}{F=Tahoma,10}{C=Dark Blue,White}{B=Blue White,Dark Blue}Run Action{T=4}{I:'a5_vertical_line'}\">\n>\n>\n<flagRunSynchronously=.F.>\n<flagWrapInTryCatch=.F.>\n<tryCatchJavascript=\"\">\n"

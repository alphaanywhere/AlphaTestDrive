        "XbasicFunctionDeclarations": "function Call_DocFusionPDFGenerate as c (e as p)\n\t\n\t'debug(1)\n\tdim json_string as c = <<%txt%\n\t{\n\t\t\"FirstName\": \"__fname__\",\n\t\t\"LastName\": \"__lname__\"\n\t}\n\t%txt%\n\tjson_string = stritran(json_string,\"__fname__\",e.DATASUBMITTED.FIRSTNAME)\n\tjson_string = stritran(json_string,\"__lname__\",e.DATASUBMITTED.LASTNAME)\t\n\t\n\tdim response as p\n\tresponse = DocFusion_GenerateDocument(e,json_string,e.DATASUBMITTED.CLIENT_ID,e.DATASUBMITTED.CLIENT_SECRET,e.DATASUBMITTED.BusinessUnitGuid,e.DATASUBMITTED.TemplateGuid,e.DATASUBMITTED.ChainGuid,\"\")\n\t\n\tdim jsStr as c\n\tif eval_valid(\"response.errors\") then\n\t\tdim errorMsg as c\n\t\terrorMsg = json_generate(response.errors._)\n\t\tjsStr = system_msgbox(\"DocFusion Error\",js_Escape(\"Contact Admin!\"),\"E\")\n\telse\n\t\tif eval_valid(\"response.DocumentData\") then\n\t\t \tfilename = Base64ToPDFFile(response.DocumentData)\n\t\t\tdim clientsideFilename as c = \"MyReport.pdf\"\n\t\t\tif e.DATASUBMITTED.PDFFILENAME <> \"\" then\n\t\t\t\tclientsideFilename =  e.DATASUBMITTED.PDFFILENAME + \".pdf\"\n\t\t\tend if\n\t\t\tdim componentAlias as c\n\t\t\tcomponentAlias = e.tmpl.alias\n\t\t\tjsStr = a5Helper_generateFileDownloadJS(componentAlias, filename, clientsideFilename)\n\n\t\tend if\n\tend if\n\t\n\tCall_DocFusionPDFGenerate = jsStr + \"{dialog.object}.hideWaitMessage();\"\n\t\nend function \n",
        "onTimerEventInterval": 60,
        "securityDeniedAction": "Redirect to login page",
